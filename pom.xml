<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM (Project Object Model) do Maven.

    Este arquivo descreve COMO o projeto é construído (build) e QUAIS bibliotecas
    (dependências) ele usa. É o equivalente ao "package.json" do mundo Node.js
    ou ao "requirements.txt" do Python, só que mais robusto: além de listar
    dependências, também define plugins de build, versão de Java, etc.

    Usamos o "spring-boot-starter-parent" como parent POM: ele já define versões
    compatíveis entre si para dezenas de bibliotecas (Jackson, Hibernate, Tomcat...),
    então não precisamos ficar escolhendo versão de cada dependência manualmente
    (isso evita o clássico problema de "dependency hell").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Linha estável mais recente do Spring Boot no momento da criação deste
             projeto (setembro/2026), com suporte oficial a Java 17-26. -->
        <version>4.1.1</version>
        <relativePath/> <!-- busca o parent no repositório Maven, não localmente -->
    </parent>

    <groupId>com.aalvarenga</groupId>
    <artifactId>billing-registration-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>billing-registration-service</name>
    <description>
        Serviço de registro de compras e faturamento (portfólio de estudos).
        Recebe requisições de venda via REST, valida regras de negócio e
        persiste contas, produtos, pagamentos e faturas em um banco MySQL.
    </description>

    <properties>
        <!-- Java 25: versão solicitada para o projeto. O Spring Boot 4.1 suporta
             oficialmente até Java 26, então não há incompatibilidade. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Sobrescreve a versão de Lombok gerenciada pelo BOM do Spring Boot
             (1.18.46) por uma mais recente (1.18.48) - a partir do JDK 23, o
             javac passou a exigir versões atualizadas para lidar corretamente
             com as novas APIs internas do compilador (ver comentário abaixo,
             em <annotationProcessorPaths>, sobre o motivo real do build ter
             quebrado). -->
        <lombok.version>1.18.48</lombok.version>

        <!-- Cucumber-JVM (BDD): versão mais recente estável no momento desta
             adição (18/09/2026) - todos os módulos do Cucumber (cucumber-java,
             cucumber-junit-platform-engine, cucumber-spring) são liberados
             juntos, sempre com o MESMO número de versão, então uma única
             property cobre os três abaixo. Diferente do JaCoCo/Checkstyle,
             aqui não há risco de incompatibilidade com o "class file version"
             do Java 25: o Cucumber não faz nenhuma leitura/parsing de
             bytecode (não é uma ferramenta de análise estática) - ele só
             executa métodos Java normalmente via reflection, então qualquer
             versão recente já roda sem problema no JDK 25. -->
        <cucumber.version>7.34.8</cucumber.version>

        <!-- Testcontainers: FOI necessário declarar explicitamente (ver
             comentário completo na dependência "testcontainers-mysql" mais
             abaixo, na seção de TESTES FUNCIONAIS/E2E, para o motivo real -
             a suposição original, de que o "spring-boot-dependencies"
             cobriria isso sozinho, se mostrou incompleta na primeira
             execução real do usuário). O valor abaixo é o MESMO usado
             internamente pelo "spring-boot-dependencies:4.1.1" (conferido
             na própria definição do BOM do Spring Boot) - usar o mesmo
             número evita duas versões diferentes de Testcontainers
             convivendo no classpath de teste. -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencies>
        <!-- ================= WEB ================= -->
        <!-- Traz o Spring MVC + Tomcat embutido para expormos endpoints REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ================= VALIDAÇÃO ================= -->
        <!-- Bean Validation (Jakarta Validation) para anotações como @NotNull,
             @NotBlank, @Positive etc. diretamente nos DTOs de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ================= PERSISTÊNCIA ================= -->
        <!-- Spring Data JPA (usa Hibernate por baixo dos panos) para mapear
             classes Java para tabelas do banco relacional -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC do MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: ferramenta de versionamento/migração de banco de dados.
             Os scripts SQL ficam em src/main/resources/db/migration e são
             aplicados automaticamente na inicialização da aplicação, na ordem
             correta (V1, V2, V3...). É a forma "boa prática" de entregar os
             scripts de criação de banco pedidos no escopo do projeto: eles
             ficam versionados, documentados e são aplicados de forma
             repetível (o mesmo script nunca roda duas vezes no mesmo banco).

             IMPORTANTE (Spring Boot 4): até o Boot 3, bastava colocar
             "flyway-core" no classpath que o Spring Boot auto-configurava
             tudo sozinho. A partir do Boot 4, a auto-configuração de cada
             integração (Flyway, Liquibase, Hibernate/JPA, etc.) foi separada
             em módulos próprios - e sem o STARTER específico, a
             auto-configuração correspondente simplesmente NÃO ativa, sem
             erro nenhum no log (foi exatamente isso que aconteceu aqui: a
             aplicação subia normalmente, conectava no MySQL, mas o Flyway
             nunca rodava as migrations, e só descobrimos porque o Hibernate
             reclamou de tabela ausente). Por isso usamos o starter abaixo em
             vez do "flyway-core" isolado. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Módulo específico de suporte ao MySQL (o "flyway-core"/starter
             sozinho não sabe dialeto nenhum de banco específico). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ================= PRODUTIVIDADE ================= -->
        <!-- Lombok: gera em tempo de compilação métodos repetitivos (getters,
             setters, construtores, builders...) a partir de anotações,
             reduzindo código "boilerplate" nas entidades e DTOs. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ================= OBSERVABILIDADE ================= -->
        <!-- Actuator expõe endpoints de saúde/monitoramento (ex: /actuator/health),
             úteis inclusive para verificar rapidamente se a app subiu com sucesso -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ================= TESTES (unidade) ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================= TESTES FUNCIONAIS/E2E (sessão de 18/09/2026) =================

             Diferente dos testes de unidade acima (services com Mockito, sem
             subir NADA), o grupo de dependências abaixo sustenta uma camada
             de teste completamente diferente: sobe a aplicação Spring Boot
             INTEIRA (Tomcat embutido de verdade, banco MySQL de verdade via
             Testcontainers) e bate nela via HTTP, exatamente como um cliente
             real faria - documentado em detalhe no doc de decisões do
             projeto ("Testes funcionais/E2E com Cucumber + REST Assured +
             Testcontainers") e no README, seção "Testes". Ficam em módulos
             (dependências) separados dos de unidade acima só por
             organização/didática - tecnicamente todos rodam a partir de
             `src/test/java`, o que os separa de fato é a FASE do Maven em
             que cada grupo executa (ver maven-surefire-plugin/
             maven-failsafe-plugin mais abaixo, na seção <build>). -->

        <!-- Motor do Cucumber: interpreta os arquivos .feature (Gherkin) e
             invoca os métodos Java anotados com @Dado/@Quando/@Então
             ("step definitions") correspondentes a cada linha. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Ponte entre o Cucumber e a JUnit Platform: sem isso, o
             maven-failsafe-plugin (que só sabe "falar" JUnit Platform/JUnit
             5) não teria como descobrir e rodar os cenários do Cucumber. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Integração oficial Cucumber<->Spring: permite que as classes de
             step definitions recebam @Autowired (repositórios, por exemplo)
             como qualquer bean Spring, e é quem sobe o ApplicationContext
             UMA VEZ só para toda a suíte (reaproveitado entre cenários,
             igual a um @SpringBootTest comum) em vez de recriar o contexto
             (e o container do Testcontainers) a cada cenário. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- "@Suite"/"@SelectClasspathResource": API usada pela classe
             RunCucumberIT (ver src/test/java/.../cucumber/RunCucumberIT.java)
             para dizer à JUnit Platform "descubra e rode os cenários do
             Cucumber aqui". Sem versão explícita de propósito: gerenciada
             pelo BOM do JUnit que o "spring-boot-dependencies" (pai deste
             pom) já importa - mesmo padrão já usado para spring-boot-starter-test
             acima (nunca precisou de versão própria). -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- REST Assured: cliente HTTP com uma DSL fluente e assertions
             prontas para JSON (given().when().then()...) - dispara as
             chamadas contra o Tomcat embutido subido pelo @SpringBootTest
             (porta aleatória, ver SpringIntegrationConfig). Sem gerenciamento
             de versão pelo Spring Boot (não é uma biblioteca "oficial" do
             ecossistema Spring), por isso a versão vem explícita aqui. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>6.0.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: sobe um MySQL real, descartável, em um container
             Docker, só para a execução dos testes - a mesma imagem usada em
             desenvolvimento local (ver README, "mysql:8.4"), garantindo que
             os testes rodem contra o MESMO motor de banco de produção (as
             triggers de auditoria em SQL nativo do MySQL, por exemplo, não
             rodariam num banco em memória como H2 - motivo pelo qual o
             projeto nunca incluiu H2 como dependência).

             CORREÇÃO (18/09/2026, primeira execução real do usuário):
             a suposição original era que o "spring-boot-dependencies" (pai
             deste pom) cobriria a versão sozinho, sem precisar declará-la
             aqui - só que isso se mostrou ERRADO na prática: o Spring Boot
             gerencia a PROPERTY "testcontainers.version" (usada por ele
             mesmo internamente, ver property acima), mas não tem uma
             entrada de <dependencyManagement> para TODO módulo específico
             do Testcontainers (o "mysql" e o "junit-jupiter" não estavam
             cobertos) - resultado: "'dependencies.dependency.version' ...
             is missing". Corrigido usando a property acima explicitamente.

             Também descobrimos, pesquisando o motivo do erro, que o
             Testcontainers 2.x (lançado em 2026, é a versão atual - a que
             o Spring Boot 4.1.1 já usa) renomeou os artefatos dos módulos
             de banco de dados, passando todos a usar o prefixo
             "testcontainers-" (era "mysql", agora é "testcontainers-mysql";
             o pacote Java também mudou, de
             "org.testcontainers.containers.MySQLContainer" para
             "org.testcontainers.mysql.MySQLContainer" - ver
             SpringIntegrationConfig.java) - e a dependência "junit-jupiter"
             foi removida por não ser mais necessária: ela só seria precisa
             para usar as anotações "@Testcontainers"/"@Container" da JUnit
             5, que este projeto NÃO usa (o container é gerenciado
             manualmente, em bloco "static" - ver SpringIntegrationConfig,
             padrão "Singleton Container"). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok só atua em tempo de compilação; não precisa
                             ir parar dentro do JAR final da aplicação -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- A partir do JDK 23, o javac deixou de "escanear" automaticamente
                 o classpath de compilação procurando processadores de anotação
                 (medida de segurança contra ataques de supply-chain via jars
                 maliciosos disfarçados de annotation processor). Isso significa
                 que, no JDK 25 usado neste projeto, o Lombok (que é implementado
                 como um annotation processor) simplesmente NUNCA rodava - por
                 isso builder(), getters/setters e o "log" do @Slf4j apareciam
                 como "cannot find symbol" em TODO o projeto, mesmo com o Lombok
                 presente no classpath. A partir de agora, precisamos declarar
                 explicitamente quais processadores rodar via
                 <annotationProcessorPaths> - deixa de ser "automático", mas em
                 troca fica explícito e não depende de heurística do compilador. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- JaCoCo: mede cobertura de código dos testes de unidade e gera um
                 relatório HTML navegável, além de imprimir o percentual agregado
                 no console via o goal "report" (ver README, seção "Testes", para
                 como ler o relatório). "prepare-agent" instrumenta o bytecode
                 ANTES da JVM de teste subir (via um javaagent), e "report" (fase
                 "test", executado logo após o surefire) lê os dados coletados e
                 gera o HTML em target/site/jacoco/index.html.

                 IMPORTANTE (versão do plugin x versão do Java): o JaCoCo lê o
                 bytecode compilado (.class) usando sua própria cópia interna da
                 biblioteca ASM, que precisa "conhecer" o número de versão do
                 class file de cada JDK novo (Java 17 = 61, ..., 24 = 68,
                 25 = 69...). A versão 0.8.12 (de antes do lançamento do Java 25)
                 não reconhece o major version 69 e falha com
                 "Unsupported class file major version 69" - os testes em si
                 passam normalmente (o javaagent de instrumentação apenas cai de
                 volta para bytecode não instrumentado quando não entende uma
                 classe), mas o goal "report" trata isso como erro fatal e
                 quebra o build. A versão 0.8.14 passou a suportar oficialmente
                 Java 25; usamos aqui a 0.8.15 (mais recente estável), que já
                 suporta oficialmente até o Java 26.

                 ESCOPO (atualizado em 18/09/2026, após a chegada dos testes
                 funcionais/E2E com Cucumber - ver maven-failsafe-plugin mais
                 abaixo): este gate ("check") continua medindo SÓ a cobertura
                 dos testes de UNIDADE (fase "test"/surefire), de propósito -
                 os cenários de Cucumber rodam depois, na fase
                 "integration-test"/"verify" (failsafe), e o goal "report"
                 acima já terminou antes disso. Agregar as duas fontes de
                 cobertura num único relatório (via "jacoco:report-aggregate")
                 é possível, mas foi deixado como evolução futura, para não
                 misturar dois objetivos diferentes de teste numa métrica só
                 antes de a suíte de Cucumber amadurecer - ver doc de
                 decisões do projeto.

                 EXCLUSÕES DA MÉTRICA (sessão de 17/09/2026): nem todo código
                 "conta" igual para uma meta de cobertura. Excluímos da conta
                 três categorias de classe que só um teste de INTEGRAÇÃO
                 (subindo o contexto Spring) exercitaria de verdade, e que não
                 têm lógica condicional própria para um teste de unidade
                 validar: a classe de bootstrap (main), os DTOs de
                 request/response (records "burros", sem decisão, cuja forma
                 já é garantida pelo compilador + Bean Validation) e a classe
                 de configuração (@ConfigurationProperties, populada pelo
                 Spring a partir do application.yml, não por código nosso).
                 Isso é prática comum (ver, por exemplo, como o SonarQube/
                 SonarCloud tipicamente configura exclusões de cobertura para
                 classes de bootstrap/DTO em projetos Spring Boot): a meta de
                 cobertura passa a refletir o código que TEM regra de negócio
                 para testar, em vez de ser diluída por bytecode gerado
                 automaticamente (getters de record, construtor padrão etc.).
                 Repare que isso NÃO altera o resultado dos testes em si -
                 só exclui essas classes do cálculo de percentual e do
                 relatório. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/BillingApplication.class</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/config/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- "check": um GATE de qualidade - faz o build FALHAR se a
                         cobertura cair abaixo do mínimo configurado (o mesmo
                         princípio por trás do "Quality Gate" padrão do
                         SonarQube/SonarCloud, que por padrão exige 80% de
                         cobertura só no código NOVO/alterado de um PR, não no
                         projeto inteiro - ver documentação do projeto,
                         "decisões e arquitetura", seção de cobertura de
                         código, para a explicação completa dessa prática e
                         por que 80% "de cara" no projeto inteiro seria uma
                         meta ruim aqui agora).

                         HISTÓRICO DO PISO (ratcheting - subindo aos poucos,
                         NUNCA descendo, conforme testes novos entram):
                           - 17/09/2026, 1ª versão: 35% (só abaixo da
                             cobertura medida na época, ~39% de linhas, pós
                             exclusões) - objetivo era só o gate existir sem
                             travar o build.
                           - 17/09/2026, após a 1ª leva de testes
                             (AssetIdFormatter/RequestLogService/
                             GlobalExceptionHandler): cobertura real subiu
                             para ~46% de linhas (confirmado via `mvn test`
                             real do usuário) - piso subido para 40%, mesma
                             margem de segurança de ~5-6 pontos percentuais
                             usada da primeira vez.
                         Próximo salto natural: depois de testar a camada de
                         orquestração/persistência (Account/Payment/Billing/
                         PurchaseOrchestrationService, hoje 0%), o piso pode
                         pular direto para 65-70%, e só então mirar os 80%
                         finais. -->
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-surefire-plugin + maven-dependency-plugin (sessão de
                 19/09/2026): sem esta configuração, o build funcionava
                 normalmente, mas imprimia uma sequência de warnings do JDK a
                 cada execução de teste, todos com a MESMA causa raiz:

                   "Mockito is currently self-attaching to enable the
                   inline-mock-maker. This will no longer work in future
                   releases of the JDK..."
                   "WARNING: A Java agent has been loaded dynamically
                   (byte-buddy-agent...)"
                   "WARNING: Dynamic loading of agents will be disallowed by
                   default in a future release"

                 O Mockito (a partir da v5, com o "inline mock maker" como
                 padrão, necessário para mockar classes finais/records) usa a
                 biblioteca Byte Buddy para se ANEXAR à JVM como um javaagent
                 DEPOIS que ela já subiu (Java Attach API). O JDK vem avisando,
                 desde a v21 (JEP 451, "Prepare to Disallow the Dynamic Loading
                 of Agents"), que essa forma DINÂMICA de carregar agents será
                 desabilitada por padrão em um release futuro - quando isso
                 acontecer, testes com Mockito param de funcionar sem nenhuma
                 mudança de código nossa, só pela troca de JDK.

                 CORREÇÃO: declarar o Mockito como agent explicitamente, junto
                 com o do JaCoCo, via "argLine" do Surefire, em vez de deixá-lo
                 se autoanexar. "@{argLine}" (arroba, não cifrão) é a sintaxe
                 que o próprio JaCoCo recomenda para combinar múltiplos agents
                 sem que um sobrescreva o outro - o "prepare-agent" do JaCoCo
                 (acima) já injeta seu próprio -javaagent nessa mesma
                 propriedade.

                 1ª TENTATIVA (falhou - registrada aqui de propósito, como
                 lição): usar "${org.mockito:mockito-core:jar}" direto no
                 argLine, assumindo que o Maven resolveria essa expressão
                 sozinho para o caminho do jar do mockito-core. Resultado real
                 (log do usuário, 19/09/2026): "Error opening zip file or JAR
                 manifest missing : ${org.mockito:mockito-core:jar}" - a
                 propriedade nunca existiu, então o Maven a passou como TEXTO
                 LITERAL para o "-javaagent:", e o java.exe tentou abrir um
                 arquivo chamado exatamente "${org.mockito:mockito-core:jar}",
                 travando a JVM forkada ANTES de qualquer teste rodar
                 ("Tests run: 0", "VM crash" - tudo consequência desse único
                 erro raiz, não problemas separados). A causa: essa sintaxe de
                 propriedade "groupId:artifactId:type" não é resolvida
                 automaticamente pelo Maven core - ela só passa a existir se o
                 goal "dependency:properties" (do maven-dependency-plugin,
                 plugin abaixo) rodar ANTES da fase "test", gerando essas
                 propriedades para cada dependência resolvida do projeto. Eu
                 tinha usado a sintaxe sem declarar esse plugin - correção
                 completa agora, com as duas peças juntas. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-javaagent-properties</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>

            <!-- Checkstyle: análise ESTÁTICA do código-fonte (não precisa
                 compilar nada - lê o .java como texto/AST), buscando bugs
                 comuns e problemas estruturais (import não usado, bloco
                 sem chaves, equals/hashCode desalinhados etc.) - ver
                 checkstyle.xml, na raiz do projeto, para o ruleset completo
                 e o racional de cada regra escolhida.

                 POR QUE ISSO É NOVO NO CI (sessão de 18/09/2026): até aqui,
                 esse tipo de warning só existia dentro do IntelliJ, na
                 máquina de quem estava codando - nada impedia um PR com
                 warning de entrar (foi exatamente por isso que precisamos
                 de duas "levas" manuais de limpeza de warnings nesta
                 sessão, ver doc de decisões do projeto). Colocar o check no
                 pipeline transforma isso de "revisão manual, às vezes
                 esquecida" em um GATE automático, que roda igual pra
                 qualquer pessoa que abrir um PR.

                 Goal "check" preso à fase "validate" (a PRIMEIRA do ciclo
                 de vida do Maven) - roda antes até de compilar, então um
                 problema aqui é descoberto (e o build falha) o mais cedo e
                 barato possível, sem gastar tempo compilando/testando um
                 código que já sabemos que tem um problema estrutural.

                 VERSÃO DO CHECKSTYLE: o maven-checkstyle-plugin 3.6.0 traz,
                 por padrão, o Checkstyle 9.3 (de 2022) - versão antiga o
                 bastante para não ter garantia de entender toda a sintaxe
                 mais nova do Java 25 usado aqui. Sobrescrevemos para a
                 14.1.0 (mais recente estável) via <dependencies> do
                 plugin, o mecanismo oficialmente documentado para isso -
                 mesmo tipo de cuidado que já tivemos com a versão do JaCoCo
                 (ver comentário do jacoco-maven-plugin acima), só que aqui
                 de forma preventiva, sem termos batido no erro ainda. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.1.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <!-- Sem "encoding"/"inputEncoding" explícito aqui de
                         propósito: o parâmetro certo do plugin chama-se
                         "inputEncoding" (não "encoding" - warning "Parameter
                         'encoding' is unknown" visto na 1ª execução real),
                         e ele já usa ${project.build.sourceEncoding} como
                         padrão, que este pom.xml já define como UTF-8 (ver
                         <properties> no topo) - declarar de novo aqui seria
                         redundante. -->
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <!-- Analisa main E test - o mesmo padrão de cuidado
                         (imports, chaves, etc.) vale pro código de teste. -->
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs (sucessor do antigo FindBugs): análise estática de
                 BYTECODE (não de texto-fonte, como o Checkstyle acima) -
                 por isso só pode rodar depois de compilar, e detecta uma
                 categoria diferente de problema: padrões de bug REAIS
                 (possível NPE, recurso que não é fechado, comparação de
                 objetos com "==" em vez de equals, etc.), não estilo de
                 código.

                 THRESHOLD "High" (só os achados de maior confiança) em vez
                 do padrão "Medium": a mesma filosofia de "ratchet" já usada
                 no piso de cobertura do JaCoCo (ver comentário acima) -
                 introduzir a ferramenta num projeto já existente com um
                 limiar mais permissivo primeiro, e apertar aos poucos,
                 evita travar o pipeline com uma enxurrada de achados de
                 baixa prioridade (muitos deles falsos positivos comuns em
                 código com Lombok/JPA/records, como "EI_EXPOSE_REP" - getter
                 que devolve a referência interna de um campo mutável) logo
                 no primeiro dia. Effort "Max" (análise mais profunda
                 possível) porque o projeto ainda é pequeno - o custo extra
                 de tempo de build é desprezível.

                 Goal "check" preso à fase "verify" (a ÚLTIMA do ciclo de
                 vida usado aqui) - só roda depois de "test" (que já inclui
                 o gate do JaCoCo) e "package" (que já gera o JAR), então um
                 problema do SpotBugs nunca impede de saber se os TESTES
                 passaram primeiro. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.4.1</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>High</threshold>
                    <failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-failsafe-plugin: o "primo" do maven-surefire-plugin
                 (que já roda os testes de unidade, na fase "test", de forma
                 implícita/automática - não aparece aqui no pom porque nunca
                 precisou de configuração customizada). A DIFERENÇA entre os
                 dois não é técnica (os dois sabem rodar testes JUnit
                 Platform) - é de FASE do ciclo de vida e de CONVENÇÃO DE
                 NOME:
                   - surefire roda na fase "test" e procura por
                     "**/*Test.java" (ex: PurchaseServiceTest);
                   - failsafe roda nas fases "integration-test"/"verify" e
                     procura por "**/*IT.java" (ex: RunCucumberIT, ver
                     src/test/java/.../cucumber/RunCucumberIT.java).

                 POR QUE SEPARAR (sessão de 18/09/2026, ver doc de decisões
                 do projeto, "Testes funcionais/E2E"): os testes de Cucumber
                 sobem a aplicação Spring Boot INTEIRA + um container Docker
                 de MySQL via Testcontainers - são ORDENS DE MAGNITUDE mais
                 lentos que os testes de unidade (segundos por cenário, não
                 milissegundos) e dependem de Docker estar disponível. Se
                 eles rodassem junto com os de unidade na fase "test", TODO
                 "mvn test" (o comando mais básico, rodado a cada salvamento/
                 build local) ficaria lento e passaria a exigir Docker
                 sempre - um custo alto para o dia a dia de quem só quer
                 rodar os testes de unidade rapidamente. Com failsafe, um
                 "mvn test" continua rápido e sem Docker; só "mvn verify"
                 (o que o pipeline de CI já usa, ver .github/workflows/ci.yml)
                 desce até a fase "integration-test" e roda os cenários de
                 Cucumber - o gate completo (unidade + funcional/E2E +
                 qualidade estática) continua sendo UM comando só.

                 PRÉ-REQUISITO: Docker precisa estar disponível em quem
                 executa "mvn verify" (localmente, via Docker Desktop, ou no
                 GitHub Actions, que já vem com Docker pré-instalado em
                 "ubuntu-latest" - nenhuma mudança adicional foi necessária
                 em ci.yml por causa disso).

                 Sem versão explícita: gerenciada pelo BOM do
                 "spring-boot-dependencies" (pai deste pom), mesmo padrão já
                 usado pelo spring-boot-maven-plugin logo no topo desta
                 seção <build>. Os goals "integration-test" e "verify" juntos
                 são o padrão documentado do próprio plugin: o primeiro RODA
                 os testes (sem falhar o build ainda, mesmo se algum cenário
                 falhar), o segundo CONFERE o resultado e falha o build se
                 necessário - two-step de propósito, para permitir um hook de
                 "teardown" entre os dois (não usado aqui, mas é o motivo da
                 API ser assim). -->
            <!-- ATUALIZAÇÃO (19/09/2026, complemento à correção do Mockito
                 registrada no maven-surefire-plugin acima): o mesmo trio de
                 warnings do JDK ("Java agent has been loaded dynamically",
                 "Mockito is currently self-attaching...", "Dynamic loading
                 of agents will be disallowed...") também aparecia aqui, na
                 fase "integration-test" (failsafe/Cucumber) - só que com uma
                 causa raiz DIFERENTE: os step definitions do Cucumber nunca
                 chamam Mockito (é um teste de ponta a ponta, com um contexto
                 Spring real e um MySQL real via Testcontainers - não há nada
                 pra "mockar"). Quem se autoanexa dinamicamente aqui é o
                 próprio HIBERNATE, que usa a mesma biblioteca por baixo dos
                 panos (Byte Buddy) para gerar, em tempo de execução, as
                 classes-proxy usadas no lazy loading de entidades JPA
                 (ex: uma FK que só é carregada do banco quando o getter é
                 chamado pela primeira vez).

                 Por que o fix do surefire não "vazou" pra cá: apesar de os
                 dois plugins compartilharem o MESMO pom.xml, cada um roda
                 sua própria JVM forkada, com seu próprio "argLine" -
                 configurar um não afeta o outro, por isso essa configuração
                 precisa existir aqui também, separadamente.

                 A correção segue exatamente o mesmo raciocínio já explicado
                 em detalhe no maven-surefire-plugin acima (mesma sintaxe
                 "@{argLine}" para conviver com o agent do JaCoCo, mesma
                 dependência do goal "dependency:properties", já registrado
                 uma única vez lá em cima na fase "initialize" - não precisa
                 ser duplicado aqui, as properties geradas valem pro build
                 inteiro) - só troca o agent declarado: em vez do jar do
                 mockito-core, o do byte-buddy-agent (a mesma biblioteca,
                 usada aqui pelo Hibernate em vez de pelo Mockito).

                 DESCOBERTA EXTRA (19/09/2026, ao ler o `mvn clean verify` real
                 do usuário após esta correção): o log mostrou o failsafe
                 rodando os cenários de Cucumber DUAS vezes seguidas -
                 "failsafe:integration-test (default)" (a que realmente
                 executa os 75 cenários) e, logo em seguida,
                 "failsafe:integration-test (cucumber-integration-tests)"
                 respondendo apenas "Skipping execution of surefire because
                 it has already been run for this configuration" (o mesmo
                 acontece de novo no goal "verify"). Causa: o
                 `spring-boot-starter-parent` (nosso `<parent>`, lá no topo
                 deste pom) já vem com uma entrada de `<pluginManagement>`
                 própria para o `maven-failsafe-plugin`, com uma `<execution>`
                 SEM id explícito (que por isso herda o id literal "default")
                 rodando exatamente os mesmos goals "integration-test"/
                 "verify" - é o motivo, aliás, de o Spring Boot "vender" o
                 failsafe como algo que "funciona sozinho" só de declarar o
                 plugin, sem precisar de `<executions>` própria. Como nossa
                 execução (id "cucumber-integration-tests") tem um id
                 DIFERENTE do id herdado ("default"), o Maven não faz merge
                 das duas em uma só - as duas ficam registradas e RODARIAM em
                 dobro, não fosse o próprio failsafe detectar que a
                 configuração é idêntica e pular a segunda automaticamente
                 (daí a mensagem "Skipping..." - inofensiva hoje, mas frágil:
                 se um dia a configuração das duas divergisse um pouco, o
                 build passaria a rodar a suíte inteira, com Testcontainers e
                 tudo, duas vezes). CORREÇÃO: renomear o id da nossa própria
                 `<execution>` para "default" também - aí o Maven faz o MERGE
                 das duas (a nossa configuração, incluindo o `argLine` do
                 Byte Buddy acima, sobrescreve/completa a herdada) em vez de
                 registrar uma execução extra, deixando só uma execução real
                 no log, como já acontecia (sem essa duplicidade aparente)
                 com o `maven-surefire-plugin` acima, que nunca declarou
                 `<executions>` própria justamente por já usar o binding
                 automático padrão. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${net.bytebuddy:byte-buddy-agent:jar}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>default</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
